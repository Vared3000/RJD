# Скопируйте этот файл в .env и заполните реальными значениями.
# Единый .env в корне читают и server (--env-file-if-exists=../.env), и client (vite envDir).

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Для запуска Docker в LAN задайте постоянный IPv4 сервера и адрес системы.
# Пример: LAN_BIND_ADDRESS=192.168.1.20 и CLIENT_ORIGIN=http://192.168.1.20
LAN_BIND_ADDRESS=192.168.1.20
LAN_SUBNET=192.168.1.0/24

# Строка подключения к PostgreSQL
DATABASE_URL=postgres://workwear_app:workwear_app_password@localhost:5432/workwear_erp

# Секреты JWT — обязательно заменить случайными строками длиной от 32 символов
JWT_ACCESS_SECRET=replace-with-random-access-secret-32-chars
JWT_REFRESH_SECRET=replace-with-random-refresh-secret-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Учётная запись администратора, создаваемая сидом при первом запуске
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-admin-password

# Используются только docker-compose для инициализации контейнера postgres
POSTGRES_DB=workwear_erp
POSTGRES_USER=workwear_app
POSTGRES_PASSWORD=replace-with-strong-database-password

# Относительный адрес работает и локально (через Vite proxy), и в Docker (через Nginx).
VITE_API_URL=/api/v1
# Release С only: retries safe reads for up to two minutes and shows reconnect state.
# Mutating requests are never retried automatically.
VITE_HA_RECONNECT=false

# Windows backup scripts (scripts/*.ps1). Use two UNC paths separated by a
# semicolon so every dump is stored on PC #1, PC #2 and PC #3. The singular
# BACKUP_SECONDARY_PATH remains supported for older installations only.
# Leave BACKUP_ROOT empty to use ./backups.
BACKUP_ROOT=
BACKUP_SECONDARY_PATHS=
BACKUP_SECONDARY_PATH=
BACKUP_TASK_USER=SYSTEM
# Optional privileged connection used only for monthly test restore (createdb/dropdb).
BACKUP_ADMIN_DATABASE_URL=

# Release P emergency-recovery fencing. Keep all three empty on a standalone
# installation. Prepared reserve nodes receive a stable cluster/node id and at
# least two semicolon-separated promotion.json witness files. If configured,
# the backend fails closed unless two different witnesses name this node active.
WORKWEAR_CLUSTER_ID=
WORKWEAR_NODE_ID=
RECOVERY_PRIMARY_HOST=
RECOVERY_WITNESS_PATHS=
RECOVERY_STATE_ROOT=
RECOVERY_SENTINEL_PATH=
# Optional extra write principals for pre-created witness shares (SID list).
RECOVERY_WITNESS_ALLOWED_SIDS=

# Release С laboratory scaffold. Keep disabled until three separate Linux VM
# nodes, Patroni/DCS synchronous replication, and one stable proxy URL pass the
# physical acceptance protocol. Never combine this mode with Release P fencing.
WORKWEAR_HA_MODE=disabled
WORKWEAR_HA_CLUSTER_ID=
WORKWEAR_HA_NODE_ID=
# Exactly three distinct endpoints: pc1=http://host1:8008;pc2=http://host2:8008;pc3=http://host3:8008
WORKWEAR_HA_PATRONI_ENDPOINTS=
WORKWEAR_HA_STABLE_URL=
WORKWEAR_HA_PROBE_TIMEOUT_MS=2000
