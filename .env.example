# Скопируйте этот файл в .env и заполните реальными значениями.
# Единый .env в корне читают и server (--env-file-if-exists=../.env), и client (vite envDir).

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Строка подключения к PostgreSQL
DATABASE_URL=postgres://workwear_app:workwear_app_password@localhost:5432/workwear_erp

# Секреты JWT — обязательно заменить случайными строками длиной от 32 символов
JWT_ACCESS_SECRET=replace-with-random-access-secret-32-chars
JWT_REFRESH_SECRET=replace-with-random-refresh-secret-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Учётная запись администратора, создаваемая сидом при первом запуске
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-admin-password

# Используются только docker-compose для инициализации контейнера postgres
POSTGRES_DB=workwear_erp
POSTGRES_USER=workwear_app
POSTGRES_PASSWORD=replace-with-strong-database-password

# Относительный адрес работает и локально (через Vite proxy), и в Docker (через Nginx).
VITE_API_URL=/api/v1
