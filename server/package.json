{
  "name": "@workwear/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "db:migrate": "node --env-file-if-exists=../.env src/database/migrate.js up",
    "db:migrate:undo": "node --env-file-if-exists=../.env src/database/migrate.js down",
    "db:seed": "node --env-file-if-exists=../.env src/database/seed.js",
    "test": "cross-env NODE_ENV=test node --env-file-if-exists=../.env --test \"src/tests/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.22.0",
    "pg-hstore": "2.3.4",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.2",
    "sequelize": "6.37.8",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "umzug": "3.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "cross-env": "10.1.0",
    "supertest": "7.2.2"
  }
}
